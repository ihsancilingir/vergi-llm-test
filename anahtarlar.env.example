# =========================================================================
# API ANAHTARLARI
# Bu dosyayı "anahtarlar.env" adıyla KOPYALAYIN ve kendi anahtarlarınızı
# yazın. runner.py bu dosyayı otomatik okur; ortam değişkeni zaten
# tanımlıysa dosyadaki değer onu EZMEZ.
#
#   cp anahtarlar.env.example anahtarlar.env
#
# DİKKAT: anahtarlar.env dosyasını asla paylaşmayın / depoya eklemeyin
# (.gitignore'a dahildir).
# =========================================================================

# Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-BURAYA-KENDI-ANAHTARINIZI-YAZIN

# OpenAI (https://platform.openai.com)
OPENAI_API_KEY=sk-BURAYA-KENDI-ANAHTARINIZI-YAZIN

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=BURAYA-KENDI-ANAHTARINIZI-YAZIN
